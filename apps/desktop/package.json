{
  "name": "@nanosync/desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "typecheck:native": "tsc -p tsconfig.json --noEmit",
    "security:gate": "bun ../../build/desktop/native-gate.ts && bun ../../build/desktop/native-gate.ts --quit",
    "prepare:native": "bash tooling.sh prepare",
    "build": "bash tooling.sh build --env=stable",
    "dev": "bash tooling.sh dev"
  },
  "devDependencies": { "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0" },
  "dependencies": {
    "@nanosync/client-local": "workspace:*",
    "@nanosync/client-service": "workspace:*",
    "@nanosync/protocol": "workspace:*",
    "@nanosync/ui-theme": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "electrobun": "2.0.6"
  }
}
