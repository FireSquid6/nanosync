<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/fg_selection">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/fg_code" />
                    <stroke android:width="2dp" android:color="@color/fg_focus" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/fg_bg" />
                    <stroke android:width="1dp" android:color="@color/fg_border" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
